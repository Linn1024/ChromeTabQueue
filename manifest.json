{
  "manifest_version": 3,
  "name": "Tab Queue",
  "version": "1.0",
  "description": "Queue tab switch",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "notifications"
  ], 
 "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "modifiers.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "switchBack": {
      "suggested_key": {
        "default": "Shift+Alt+D"
      },
      "description": "Switch between tabs"
    },
    "switchForward": {
      "suggested_key": {
        "default": "Shift+Alt+F"
      },
      "description": "Switch between tabs (remove error)"
    },
    "showQueue": {
      "suggested_key": {
        "default": "Shift+Alt+Q"
      },
      "description": "Shows queue of tabs"
    }
  }
}
